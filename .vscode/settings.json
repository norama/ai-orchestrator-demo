{
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,

  // --------------------
  // Python / Backend
  // --------------------
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "always",
      "source.unusedImports": "always"
    }
  },

  "python.defaultInterpreterPath": "${workspaceFolder}/backend/.venv/bin/python",
  "python.createEnvironment.contentButton": "show",
  "python.terminal.activateEnvInCurrentTerminal": true,
  "python.testing.pytestEnabled": true,
  "python.testing.cwd": "${workspaceFolder}",
  "python.envFile": "${workspaceFolder}/backend/.env",
  "python.analysis.extraPaths": ["${workspaceFolder}/backend"],
  "python.testing.pytestArgs": ["-s", "./backend"],
  "python.languageServer": "Pylance",
  "python.analysis.typeCheckingMode": "strict",

  // --------------------
  // Frontend / Prettier
  // --------------------
  "js/ts.preferences.importModuleSpecifier": "non-relative",
  "js/ts.preferences.importModuleSpecifierEnding": "minimal",
  "prettier.configPath": "frontend/.prettierrc",
  "prettier.requireConfig": true,

  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  "eslint.workingDirectories": [{ "directory": "frontend", "changeProcessCWD": true }],
  "js/ts.tsdk.path": "frontend/node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "css.lint.unknownAtRules": "ignore",
  "python-envs.defaultEnvManager": "ms-python.python:poetry",
  "python-envs.defaultPackageManager": "ms-python.python:poetry"
}
